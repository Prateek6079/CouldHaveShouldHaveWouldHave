// Shallow Indian component rules and urban/reverse/rural address orders.
unit: UNIT_KEY ID | ID
house_no: HOUSE_KEY ID | ID
floor: ORDINAL FLOOR_KEY | NUMBER FLOOR_KEY | FLOOR_KEY NUMBER | FLOOR_KEY ORDINAL | FLOOR_SPECIAL
building: WORD+ BUILDING_KEY WORD* | BUILDING_KEY WORD+ | KNOWN_BUILDING
locality: WORD+ LOCALITY_KEY WORD* | LOCALITY_KEY WORD+ | KNOWN_LOCALITY
district: DISTRICT_KEY WORD+ | WORD+ DISTRICT_KEY | KNOWN_DISTRICT
village_component: VILLAGE_KEY WORD+ | WORD+ VILLAGE_KEY
street: HOUSE? WORD* STREET_KEY DIRECTION? | HOUSE? ORDINAL STREET_KEY | NUMBER STREET_KEY | HOUSE? STREET_KEY NUMBER
landmark: LANDMARK_KEY WORD+
po_box: BOX_KEY ID
postal_code: POSTAL_KEY? PIN

// Strong granular-to-large prior. Residential components can swap order
// locally; reverse addresses still extract components but remain partial.
address: delivery? LOCALITY* CITY? rural_area* STATE? POSTAL?
       | delivery? VILLAGE rural_area* STATE? POSTAL?
delivery: (HOUSE | UNIT | FLOOR | BUILDING | POBOX)+ STREET?
        | STREET
rural_area: DISTRICT | POST_OFFICE | SUBDISTRICT | MANDAL | BLOCK
%declare UNIT_KEY HOUSE_KEY ID ORDINAL NUMBER FLOOR_KEY FLOOR_SPECIAL WORD BUILDING_KEY
%declare LOCALITY_KEY KNOWN_LOCALITY KNOWN_BUILDING DISTRICT_KEY KNOWN_DISTRICT VILLAGE_KEY
%declare HOUSE STREET_KEY DIRECTION LANDMARK_KEY BOX_KEY POSTAL_KEY PIN
%declare UNIT FLOOR BUILDING LOCALITY DISTRICT VILLAGE CITY STATE POSTAL LANDMARK POBOX STREET
%declare POST_OFFICE SUBDISTRICT MANDAL BLOCK
